# Database (Neon Postgres) — must be a full postgres URL (required locally and on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth (Google OAuth)
AUTH_SECRET="generate-a-long-random-string"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Public URL of the deployed site (used by Auth.js + OpenRouter headers)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob — recipe photos (create a token in the Vercel dashboard → Blob)
BLOB_READ_WRITE_TOKEN=""

# Vercel Blob store mode: set to "private" if the store is private-only (matches Vercel dashboard).
# Unset = public direct URLs. private = upload with private access; images are proxied at /api/blob/image.
# NEXT_PUBLIC_BLOB_ACCESS=private

# OpenRouter — AI structuring (optional locally; required for “Organize with AI”)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Optional Upstash Redis for distributed rate limits (not wired by default; code uses in-memory limits)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Allow `next build` without real secrets during CI scaffolding (do not use in production)
# SKIP_ENV_VALIDATION=1
